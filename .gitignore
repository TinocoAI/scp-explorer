# Runtime / generated artifacts — never committed.
# (When Herdr runs the plugin, durable state goes to $HERDR_PLUGIN_STATE_DIR,
#  outside this repo. These only appear if you run the script directly.)
mouse_down_bit
scp-explorer*.log

# Stray captures / junk that may land in the plugin dir
*.pcap
*.pcapng

# Python cache
__pycache__/
*.pyc
*.pyo

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/
